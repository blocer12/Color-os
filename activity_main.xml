<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Global Search Pill -->
    <LinearLayout
        android:id="@+id/searchPill"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_pill"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/cos_text_primary"
            android:textColorHint="@color/cos_text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Mind Suggest Liquid Acrylic Card -->
    <LinearLayout
        android:id="@+id/mindSuggestCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_liquid_acrylic_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/searchPill">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mind_suggest_title"
            android:textColor="@color/cos_accent_blue"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/clockText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="12:30 PM"
            android:textColor="@color/cos_text_primary"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateBatteryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Mon, Nov 16  •  Battery 100%"
            android:textColor="@color/cos_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Mind Space Panel -->
    <TextView
        android:id="@+id/mindSpacePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_liquid_acrylic_card"
        android:elevation="4dp"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/mind_space_placeholder"
        android:textColor="@color/cos_text_primary"
        android:textSize="15sp"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/floatingIslandContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mindSuggestCard" />

    <!-- Adaptive App Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/appGridRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:clipToPadding="false"
        app:layout_constraintBottom_toTopOf="@id/floatingIslandContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mindSuggestCard" />

    <!-- ColorOS 17 Global Floating Island Navigation + Pinned Dock -->
    <LinearLayout
        android:id="@+id/floatingIslandContainer"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:background="@drawable/bg_floating_island"
        android:elevation="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/navHomeBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Home"
            android:src="@drawable/ic_home" />

        <ImageButton
            android:id="@+id/navMindSpaceBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Mind Space"
            android:src="@drawable/ic_mind_space" />

        <ImageButton
            android:id="@+id/navDrawerBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="All Apps"
            android:src="@drawable/ic_apps" />

        <View
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginHorizontal="6dp"
            android:background="#33000000" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dockRecycler"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:overScrollMode="never" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
